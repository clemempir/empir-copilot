# Copier en .env.local et renseigner avec ton projet Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...
# Client OAuth Google (type « Web ») — nécessaire pour « Continuer avec Google ».
# Dans Google Cloud Console, ajouter l'URI de redirection :
#   https://<ID-EXTENSION>.chromiumapp.org/
# Et dans Supabase (Auth → Providers → Google), lister ce client ID dans
# « Authorized Client IDs ».
VITE_GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
